{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/domain/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "react/*",
                  "react-dom/*"
                ],
                "message": "domain은 순수 TypeScript여야 합니다"
              },
              {
                "group": [
                  "**/adapters/**",
                  "**/ui/**",
                  "**/app/**"
                ],
                "message": "domain은 adapters·ui·app을 알면 안 됩니다"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/ui/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/adapters/**"
                ],
                "message": "ui는 adapters를 직접 쓰지 말고 app이 넘겨준 포트를 써야 합니다 (ADR-0004)"
              }
            ]
          }
        ]
      }
    }
  ]
}
