# 로컬 데모 프록시 (ADR-0021)
# - :8080  http. 웹 전용이다. 인증서가 없어도 뜬다
# - :8443  https. 웹과 데스크톱 앱이 쓴다. 엔트리포인트가 인증서를 찾으면 https.caddy를 켠다
{
	# 관리 API를 끈다. 설정은 이 파일로만 바꾼다
	admin off
	persist_config off
	# 8443의 인증서는 직접 지정한다. 80 포트 리다이렉트와 인증서 발급을 하지 않는다
	auto_https disable_redirects
	# HTTP/3(UDP)는 열지 않는다. Alt-Svc h3 광고도 하지 않는다
	servers {
		protocols h1 h2
	}
}

(keymanage) {
	encode zstd gzip

	# 웹은 앱 자신의 스크립트·스타일과 같은 출처 API만 쓴다. 데스크톱 릴리스 CSP와 같은 기준이다 (ADR-0013)
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# API는 백엔드로 넘긴다. Host는 그대로 넘기고, X-Forwarded-For에는 접속 IP를 적는다
	handle /api/* {
		reverse_proxy backend:8080
	}

	# 나머지는 웹 정적 파일이다. 없는 경로는 index.html로 돌린다
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# 정해진 Host로 온 요청만 받는다. 다른 Host는 아래에서 거절한다 (DNS 리바인딩 방지)
http://localhost:8080, http://127.0.0.1:8080 {
	import keymanage
}

http://:8080 {
	respond "Misdirected Request" 421
}

import /etc/caddy/enabled/*.caddy
