{
  "$description": "KeyManage 시멘틱 디자인 토큰 원본 (ADR-0026). 값을 바꾸면 node Tools/design-tokens/generate.mjs를 실행한다. 이름과 의미는 docs/design-system.md 2·3장을 따른다.",
  "color": {
    "background": { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#000000" } },
    "foreground": { "$type": "color", "$value": { "light": "#0A0A0A", "dark": "#FAFAFA" } },
    "card": { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#141414" } },
    "card-foreground": { "$type": "color", "$value": { "light": "#0A0A0A", "dark": "#FAFAFA" } },
    "primary": { "$type": "color", "$value": { "light": "#0A0A0A", "dark": "#FAFAFA" } },
    "primary-foreground": { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#0A0A0A" } },
    "accent": { "$type": "color", "$value": { "light": "#059669", "dark": "#10B981" } },
    "accent-foreground": { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#0A0A0A" } },
    "muted": { "$type": "color", "$value": { "light": "#F5F5F5", "dark": "#262626" } },
    "muted-foreground": { "$type": "color", "$value": { "light": "#737373", "dark": "#A3A3A3" } },
    "destructive": { "$type": "color", "$value": { "light": "#DC2626", "dark": "#EF4444" } },
    "destructive-foreground": { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#FFFFFF" } },
    "border": { "$type": "color", "$value": { "light": "#E5E5E5", "dark": "rgba(255, 255, 255, 0.12)" } },
    "input": { "$type": "color", "$value": { "light": "#E5E5E5", "dark": "#262626" } },
    "ring": { "$type": "color", "$value": { "light": "#0A0A0A", "dark": "#FAFAFA" } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "5": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "lg": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
  }
}
